<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_bg"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/text_primary"
            app:title="About"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.App.H2"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="48dp"
                app:cardBackgroundColor="@color/surface_elevated"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="32dp"
                    android:src="@drawable/ic_printer"
                    app:tint="@color/primary_accent" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.App.H1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/textVersion"
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Version 1.0.0" />

            <TextView
                style="@style/TextAppearance.App.Body1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/about_description" />

            <TextView
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:letterSpacing="0.1"
                android:text="@string/developed_by"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.App.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tadiwa E Tembo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebsite"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/website_label"
                    android:gravity="start|center_vertical"
                    app:icon="@drawable/ic_analytics" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmail"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_label"
                    android:gravity="start|center_vertical"
                    app:icon="@drawable/ic_history" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGithub"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/github_label"
                    android:gravity="start|center_vertical"
                    app:icon="@drawable/ic_qr_code" />

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                app:dividerColor="@color/border_divider" />

            <TextView
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="© 2026 Tadiwa Print Buddy. All rights reserved."
                android:textSize="10sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
