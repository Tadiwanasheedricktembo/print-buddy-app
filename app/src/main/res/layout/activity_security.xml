<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintBottom_toTopOf="@+id/txtTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/txtTitle"
        style="@style/TextAppearance.App.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@+id/txtSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgLogo" />

    <TextView
        android:id="@+id/txtSubtitle"
        style="@style/TextAppearance.App.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/app_locked"
        app:layout_constraintBottom_toTopOf="@+id/layoutPinDots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTitle" />

    <!-- PIN DOTS -->
    <LinearLayout
        android:id="@+id/layoutPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/layoutNumericPad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtSubtitle">

        <ImageView
            android:id="@+id/dot1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/ic_pin_dot_empty"
            app:tint="@color/text_disabled" />
        <ImageView
            android:id="@+id/dot2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/ic_pin_dot_empty"
            app:tint="@color/text_disabled" />
        <ImageView
            android:id="@+id/dot3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/ic_pin_dot_empty"
            app:tint="@color/text_disabled" />
        <ImageView
            android:id="@+id/dot4"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/ic_pin_dot_empty"
            app:tint="@color/text_disabled" />
        <ImageView
            android:id="@+id/dot5"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/ic_pin_dot_empty"
            android:visibility="gone"
            app:tint="@color/text_disabled" />
        <ImageView
            android:id="@+id/dot6"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/ic_pin_dot_empty"
            android:visibility="gone"
            app:tint="@color/text_disabled" />
    </LinearLayout>

    <!-- NUMERIC PAD -->
    <GridLayout
        android:id="@+id/layoutNumericPad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:columnCount="3"
        android:rowCount="4"
        app:layout_constraintBottom_toTopOf="@+id/btnBiometric"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutPinDots">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="1"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="2"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="3"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="4"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="5"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="6"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="7"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="8"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="9"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />

        <Space
            android:layout_width="80dp"
            android:layout_height="80dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn0"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="0"
            android:textSize="28sp"
            android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:icon="@drawable/ic_backspace"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp"
            app:iconTint="@color/text_secondary" />
    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBiometric"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="Use Biometric"
        android:textColor="@color/brand_primary"
        app:icon="@drawable/ic_fingerprint"
        app:iconTint="@color/brand_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutNumericPad" />

</androidx.constraintlayout.widget.ConstraintLayout>
