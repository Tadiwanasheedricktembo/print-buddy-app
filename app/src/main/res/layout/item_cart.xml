<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/grid_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_cart_service_name"
                style="@style/TextAppearance.App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Photocopy B/W" />

            <TextView
                android:id="@+id/text_cart_price"
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="₹ 2.00 unit price" />

            <TextView
                android:id="@+id/text_cart_subtotal"
                style="@style/TextAppearance.App.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/brand_primary"
                android:textSize="18sp"
                tools:text="Subtotal: ₹ 4.00" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/brand_divider"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_minus"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="-"
                    android:padding="0dp"
                    app:backgroundTint="@color/brand_surface"
                    app:cornerRadius="8dp" />

                <TextView
                    android:id="@+id/text_cart_quantity"
                    style="@style/TextAppearance.App.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="36dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    tools:text="2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_plus"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="+"
                    android:padding="0dp"
                    app:backgroundTint="@color/brand_surface"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>