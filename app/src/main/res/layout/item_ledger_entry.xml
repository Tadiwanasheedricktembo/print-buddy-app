<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp"
    android:paddingVertical="12dp">

    <!-- MINIMAL TIMELINE INDICATOR -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginEnd="16dp">

        <View
            android:id="@+id/lineTop"
            android:layout_width="1dp"
            android:layout_height="8dp"
            android:background="@color/brand_divider" />

        <View
            android:id="@+id/circleIcon"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_circle_dot"
            android:backgroundTint="@color/brand_outline" />

        <View
            android:id="@+id/lineBottom"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/brand_divider" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Debt Added" />

            <TextView
                android:id="@+id/textDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="11:42 AM" />
        </LinearLayout>

        <TextView
            android:id="@+id/textNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Order #1024 for 10 prints" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_error"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="+ ₹ 3.00" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/brand_divider" />

            <TextView
                android:id="@+id/textNewBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                tools:text="BAL: ₹ 8.00" />
        </LinearLayout>
    </LinearLayout>

    <!-- HIDDEN LEGACY VIEWS FOR BINDING SAFETY -->
    <View android:id="@+id/prevBalance" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/textPrevBalance" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/cardContent" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/imageIcon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</LinearLayout>
