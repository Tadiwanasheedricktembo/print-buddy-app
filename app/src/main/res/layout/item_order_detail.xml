<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/grid_8"
    app:cardBackgroundColor="@color/brand_surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/brand_divider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textItemName"
                style="@style/TextAppearance.App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                tools:text="A4 Color Printing" />

            <TextView
                android:id="@+id/textItemQuantity"
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Quantity: 10" />
        </LinearLayout>

        <TextView
            android:id="@+id/textItemPrice"
            style="@style/TextAppearance.App.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_primary"
            android:textSize="16sp"
            tools:text="₹ 50.00" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>