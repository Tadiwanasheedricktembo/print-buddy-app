<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TadiwaPrintBuddy" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/brand_surface</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorOutlineVariant">@color/brand_divider</item>

        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>

        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
        <item name="materialDividerStyle">@style/Widget.App.Divider</item>
    </style>

    <style name="Theme.TadiwaPrintBuddy" parent="Base.Theme.TadiwaPrintBuddy" />

    <!-- REUSABLE COMPONENT STYLES -->

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="strokeColor">@color/brand_divider</item>
        <item name="cardBackgroundColor">@color/brand_surface</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.App.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="iconTint">#FFFFFF</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.App.Button">
        <item name="backgroundTint">@color/brand_secondary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="iconTint">#FFFFFF</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxBackgroundColor">#1F2937</item> <!-- Subtle contrast vs background -->
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="Widget.App.TextInputLayout.Dropdown" parent="Widget.App.TextInputLayout">
        <!-- Inherits from TextInputLayout -->
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/brand_background</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.Indicator</item>
        <item name="itemIconTint">@color/selector_nav_colors</item>
        <item name="itemTextColor">@color/selector_nav_colors</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.App.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#1A3B82F6</item> <!-- Subtle blue tint -->
        <item name="marginHorizontal">12dp</item>
    </style>

    <style name="Widget.App.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/brand_divider</item>
        <item name="android:thickness">1dp</item>
    </style>

    <!-- TYPOGRAPHY STYLES -->
    <style name="TextAppearance.App.Heading" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_h2</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextAppearance.App.Value" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- TOGGLE GROUP SHAPES -->
    <style name="ShapeAppearance.App.Toggle.Start" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSizeTopLeft">@dimen/input_radius</item>
        <item name="cornerSizeBottomLeft">@dimen/input_radius</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Toggle.Middle" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Toggle.End" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSizeTopRight">@dimen/input_radius</item>
        <item name="cornerSizeBottomRight">@dimen/input_radius</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Image.Top" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSizeTopLeft">@dimen/radius_medium</item>
        <item name="cornerSizeTopRight">@dimen/radius_medium</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="postSplashScreenTheme">@style/Theme.TadiwaPrintBuddy</item>
    </style>
</resources>
