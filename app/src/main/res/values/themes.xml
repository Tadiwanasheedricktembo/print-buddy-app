<resources>
    <!-- Base application theme -->
    <style name="Base.Theme.TadiwaPrintBuddy" parent="Theme.Material3.Dark.NoActionBar">
        <item name="isLightTheme">false</item>

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/primary_bg</item>
        <item name="android:windowBackground">@color/primary_bg</item>

        <item name="colorError">@color/destructive</item>
        <item name="colorOnError">@color/white</item>

        <item name="colorOutline">@color/border_divider</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/primary_bg</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
    </style>

    <style name="Theme.TadiwaPrintBuddy" parent="Base.Theme.TadiwaPrintBuddy" />

    <!-- TYPOGRAPHY STYLES -->
    <style name="TextAppearance.App" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextAppearance.App.H1">
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.H2">
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body1">
        <item name="android:textSize">@dimen/text_body1</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body2">
        <item name="android:textSize">@dimen/text_body2</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Label">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TextAppearance.App.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Legacy / Alias Styles for build compatibility -->
    <style name="TextAppearance.App.Title" parent="@style/TextAppearance.App.H2" />
    <style name="TextAppearance.App.SectionHeader" parent="@style/TextAppearance.App.H2" />
    <style name="TextAppearance.App.Heading" parent="@style/TextAppearance.App.H1" />
    <style name="TextAppearance.App.Value">
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- COMPONENT STYLES -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/border_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.App.Button.CTA" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/height_button_cta</item>
        <item name="backgroundTint">@color/primary_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="@style/Widget.App.Button.CTA" />

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/height_button_secondary</item>
        <item name="strokeColor">@color/primary_accent</item>
        <item name="android:textColor">@color/primary_accent</item>
        <item name="backgroundTint">@color/surface_elevated</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/border_divider</item>
        <item name="boxBackgroundColor">@color/surface_elevated</item>
        <item name="hintTextColor">@color/text_disabled</item>
        <item name="android:textColorHint">@color/text_disabled</item>
        <item name="startIconTint">@color/text_secondary</item>
    </style>

    <style name="Widget.App.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/selector_toggle_text</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/selector_toggle_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.App.Image.Top" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_card</item>
        <item name="cornerSizeTopRight">@dimen/radius_card</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_final</item>
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="postSplashScreenTheme">@style/Theme.TadiwaPrintBuddy</item>
    </style>

    <style name="Theme.App.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

</resources>
